# Perfil da demonstração (ADR 013): npm run lab:demo.
# Só intervalos curtos, para a plateia ver a queda e a volta em segundos.
# Segredos (CONTINUUM_POSTGRES_URL) continuam no .env, que também é lido.
# Os testes não usam este arquivo: continuam com os parâmetros padrão.

# Health check a cada 1 s; tempo limite de 800 ms. A folga importa: uma única
# falha em RECUPERANDO volta para OFFLINE (docs/estados.md).
CONTINUUM_HEALTH_INTERVALO_MS=1000
CONTINUUM_HEALTH_TIMEOUT_MS=800

# Envio: lotes de 100, sem esperar 10 s por um lote preso, e nova tentativa
# rápida depois de um erro temporário.
CONTINUUM_SYNC_TAMANHO_LOTE=100
CONTINUUM_SYNC_TIMEOUT_MS=3000
CONTINUUM_SYNC_BACKOFF_INICIAL_MS=200
CONTINUUM_SYNC_BACKOFF_MAXIMO_MS=1000
