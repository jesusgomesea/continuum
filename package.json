{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "description": "Continuum: PDV, ERP do cliente e Central, Local First (monorepo)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "pacotes/*"
  ],
  "scripts": {
    "versao": "node -v",
    "testar": "vitest run",
    "testar:assistir": "vitest",
    "verificar": "tsc -p tsconfig.json",
    "vitrine": "vite --config pacotes/interface/vite.config.ts",
    "pdv": "vite --config pacotes/pdv/vite.config.ts",
    "pdv:app": "node pacotes/pdv/scripts/montar.ts app",
    "pdv:exe": "node pacotes/pdv/scripts/montar.ts exe",
    "agente": "node pacotes/agente/src/iniciar.ts",
    "agente:exe": "node pacotes/agente/scripts/montar.ts",
    "teste-de-queda": "node pacotes/agente/scripts/teste-de-queda.ts",
    "nuvem": "node pacotes/nuvem/src/iniciar.ts",
    "erp": "vite --config pacotes/nuvem/vite.config.ts",
    "nuvem:exe": "node pacotes/nuvem/scripts/montar.ts",
    "instaladores": "node scripts/gerar-instaladores.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  }
}
